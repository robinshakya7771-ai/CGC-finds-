datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  hashedPassword String?  // For Credentials provider
  accounts      Account[]
  sessions      Session[]
  items         Item[]
  messages      Message[]
  chats         Chat[]    @relation("UserChats")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id           String   @id @default(cuid())
  type         String   // "LOST" or "FOUND"
  title        String
  category     String   // e.g., "Electronics", "Keys", "Clothing"
  description  String
  location     String
  date         DateTime
  imageUrl     String?  // Base64 string for lightweight local storage without extra services
  status       String   @default("ACTIVE") // "ACTIVE" or "RESOLVED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats        Chat[]
}

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  participants User[]    @relation("UserChats")
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}
